{
  "name": "ai-quota-notch",
  "version": "0.1.0",
  "private": true,
  "description": "Indicador discreto estilo notch para limites do Claude e Codex no Windows e no Linux",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:linux": "electron . --ozone-platform-hint=auto",
    "demo": "electron . --demo",
    "demo:multi": "electron . --demo=2",
    "test": "bun test",
    "dist": "electron-builder --win --x64",
    "icon": "uv run --with pillow scripts/make-icon.py",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "desktop:update": "bun scripts/update.mjs"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "br.com.guepardosys.aiquotanotch",
    "productName": "AI Quota Notch",
    "directories": {
      "output": "out"
    },
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "ai-quota-notch",
      "synopsis": "Limites do Claude e do Codex em um notch",
      "desktop": {
        "entry": {
          "StartupWMClass": "ai-quota-notch",
          "Comment": "Limites de uso do Claude e do Codex em um notch no topo da tela"
        }
      },
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "ai-quota-notch-${version}-x86_64.AppImage"
    }
  },
  "desktopName": "ai-quota-notch.desktop"
}
